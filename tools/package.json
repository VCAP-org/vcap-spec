{
  "name": "vcap-spec-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reference tooling for the vcap proof format: canonicalization, trailer, segment chain, vector generator and the reference verifier that checks every committed vector.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate": "tsx src/generate.ts",
    "generate:edge-cases": "tsx src/generate-edge-cases.ts",
    "validate": "tsx src/validate.ts",
    "manifest": "tsx src/manifest.ts",
    "manifest:check": "tsx src/manifest.ts --check",
    "conformance:report": "tsx src/conformance-report.ts",
    "conformance:check": "tsx src/conformance-report.ts --check"
  },
  "devDependencies": {
    "@noble/curves": "^2.4.0",
    "@peculiar/x509": "^2.1.0",
    "@types/node": "^22.10.5",
    "asn1js": "^3.0.10",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "license": "MIT"
}
