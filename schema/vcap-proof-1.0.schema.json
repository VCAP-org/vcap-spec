{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vcap.dev/schema/vcap-proof-1.0.schema.json",
  "title": "vcap proof, version 1.0",
  "description": "Structural schema of a vcap/1.0 proof. Gates writers: a proof that fails here is not a vcap/1.0 proof. It does not decide verdicts — a schema-valid proof can still be tampered — and it does not model the verifier's tolerance of newer minors (§9): unknown top-level keys are allowed, unknown keys inside known objects are not, because a 1.0 writer has no business emitting them.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "v",
    "capture_id",
    "media",
    "device",
    "sig"
  ],
  "properties": {
    "v": {
      "type": "string",
      "pattern": "^vcap/1\\.[0-9]+$"
    },
    "capture_id": {
      "$ref": "#/$defs/bytes16"
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mime",
        "hash",
        "w",
        "h"
      ],
      "properties": {
        "mime": {
          "type": "string",
          "pattern": "^(image|video)/[a-z0-9.+-]+$"
        },
        "w": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "h": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "duration_ms": {
          "$ref": "#/$defs/uint32"
        },
        "hash": {
          "$ref": "#/$defs/bytes32"
        },
        "segment_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "description": "uint32: n in the §5 segment message is uint32 BE"
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "secure_hw",
        "key_id"
      ],
      "properties": {
        "platform": {
          "enum": [
            "android",
            "ios",
            "web"
          ]
        },
        "secure_hw": {
          "enum": [
            "strongbox",
            "tee",
            "secureEnclave",
            "none"
          ]
        },
        "key_id": {
          "$ref": "#/$defs/bytes32"
        }
      }
    },
    "watermark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algo",
        "layout"
      ],
      "properties": {
        "algo": {
          "$ref": "#/$defs/identifier"
        },
        "layout": {
          "$ref": "#/$defs/identifier",
          "description": "Extensible (§9): photo-bch-v3 and video-rep-v1 in this version; a verifier that does not implement a layout reports *watermark not evaluated*."
        },
        "payload_bits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "ecc": {
          "$ref": "#/$defs/identifier"
        },
        "strength": {
          "$ref": "#/$defs/uint32"
        },
        "mark_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777215
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "device_clock": {
          "$ref": "#/$defs/uint53",
          "description": "milliseconds since the Unix epoch, UTC"
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "enum": [
            "declared",
            "corroborated",
            "authenticated"
          ],
          "description": "The level the device claims (§7.1). A writer claims `declared`; `authenticated` is reserved for device-side evidence a later minor defines; `corroborated` is never a writer's claim, it comes from the `location_corroboration` attachment. The verifier computes the reached level and the claim never raises it."
        },
        "lat_udeg": {
          "type": "integer",
          "minimum": -90000000,
          "maximum": 90000000
        },
        "lon_udeg": {
          "type": "integer",
          "minimum": -180000000,
          "maximum": 180000000
        },
        "acc_cm": {
          "$ref": "#/$defs/uint32"
        },
        "alt_cm": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 10000000,
          "description": "height above the WGS 84 ellipsoid, integer centimetres"
        },
        "source": {
          "$ref": "#/$defs/identifier",
          "description": "How the device obtained the fix: gnss, network or manual. Extensible (§9); an unknown value is still a declared position."
        },
        "at": {
          "$ref": "#/$defs/uint53",
          "description": "device clock when the fix was taken, ms since the Unix epoch; may precede time.device_clock"
        },
        "evidence": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pseudonymous": {
          "type": "boolean"
        },
        "retention_ref": {
          "$ref": "#/$defs/opaqueRef"
        }
      }
    },
    "sig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alg",
        "value",
        "pub"
      ],
      "properties": {
        "alg": {
          "const": "ES256"
        },
        "value": {
          "$ref": "#/$defs/p1363"
        },
        "pub": {
          "$ref": "#/$defs/spkiP256"
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gop",
          "hash",
          "prev",
          "sig"
        ],
        "properties": {
          "gop": {
            "$ref": "#/$defs/uint32"
          },
          "range": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "deprecated": true,
            "description": "Deprecated and unsigned: writers MUST NOT emit it, verifiers MUST ignore it (§5)."
          },
          "hash": {
            "$ref": "#/$defs/bytes32"
          },
          "prev": {
            "$ref": "#/$defs/bytes32"
          },
          "sig": {
            "$ref": "#/$defs/p1363"
          }
        }
      }
    },
    "attestation": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/base64url"
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "log_id",
        "leaf_index",
        "leaf",
        "inclusion_path",
        "tree_head"
      ],
      "properties": {
        "log_id": {
          "$ref": "#/$defs/bytes32"
        },
        "leaf_index": {
          "$ref": "#/$defs/uint53"
        },
        "leaf": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "key_id",
            "public_key",
            "secure_hw",
            "attestation_digest",
            "registered_at"
          ],
          "properties": {
            "type": {
              "const": "key"
            },
            "key_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "public_key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]{122}==$",
              "description": "DER SPKI of the P-256 key, standard base64 as the log records it"
            },
            "secure_hw": {
              "enum": [
                "strongbox",
                "tee",
                "secureEnclave"
              ]
            },
            "attestation_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "registered_at": {
              "$ref": "#/$defs/uint53"
            }
          }
        },
        "inclusion_path": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/bytes32"
          }
        },
        "tree_head": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tree_size",
            "timestamp",
            "root_hash",
            "signature"
          ],
          "properties": {
            "tree_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "timestamp": {
              "$ref": "#/$defs/uint53"
            },
            "root_hash": {
              "$ref": "#/$defs/bytes32"
            },
            "signature": {
              "$ref": "#/$defs/p1363"
            }
          }
        }
      }
    },
    "timestamp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tsr"
      ],
      "properties": {
        "tsr": {
          "$ref": "#/$defs/base64url"
        },
        "tsa_issuer": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain",
        "tx",
        "block",
        "anchor_id",
        "index",
        "tree_size",
        "root",
        "merkle_path"
      ],
      "properties": {
        "chain": {
          "$ref": "#/$defs/identifier"
        },
        "tx": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "block": {
          "$ref": "#/$defs/uint53"
        },
        "anchor_id": {
          "$ref": "#/$defs/uint53"
        },
        "index": {
          "$ref": "#/$defs/uint53"
        },
        "tree_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "root": {
          "$ref": "#/$defs/bytes32"
        },
        "merkle_path": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/bytes32"
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "verdict",
        "evaluated_at",
        "sig"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/identifier",
          "description": "Extensible (§9): playIntegrity, appAttest, none in this version; a verifier that does not know the value reports *integrity unevaluated*."
        },
        "verdict": {
          "enum": [
            "hardware",
            "basic",
            "unevaluated",
            "failed"
          ]
        },
        "evaluated_at": {
          "$ref": "#/$defs/uint53"
        },
        "sig": {
          "$ref": "#/$defs/p1363",
          "description": "registry key ES256 over \"vcap/1.0/integrity\" ‖ core_hash ‖ JCS(attachment without sig)"
        }
      }
    },
    "attestation_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "fetched_at",
        "entries",
        "sig"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/identifier",
          "description": "Where the status came from. Extensible (§9); googleStatusList is Android's attestation status list."
        },
        "fetched_at": {
          "$ref": "#/$defs/uint53",
          "description": "registry clock when the status was read, ms. Not a revocation date."
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "serial",
              "status"
            ],
            "properties": {
              "serial": {
                "$ref": "#/$defs/hexSerial"
              },
              "status": {
                "enum": [
                  "valid",
                  "revoked",
                  "unknown"
                ]
              },
              "reason": {
                "type": "string",
                "maxLength": 64
              },
              "revoked_at": {
                "$ref": "#/$defs/uint53",
                "description": "the revocation date the source itself gives, ms; absent when the source gives none (§6.2)"
              }
            }
          }
        },
        "sig": {
          "$ref": "#/$defs/p1363"
        }
      }
    },
    "location_corroboration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "result",
        "at",
        "sig"
      ],
      "description": "§6.2: an operator-side check of the declared position, relayed and signed by the registry. Never carries a phone number.",
      "properties": {
        "method": {
          "$ref": "#/$defs/identifier",
          "description": "The CAMARA API the registry called: camara-location-verification, camara-number-verification, camara-sim-swap. Extensible (§9); a v1.0 verifier reads an unknown method as *location corroboration not evaluated*."
        },
        "result": {
          "enum": [
            "match",
            "no-match",
            "unknown"
          ]
        },
        "radius_m": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "description": "the circle around the declared position the operator was asked about; required by §6.2 when method is camara-location-verification"
        },
        "at": {
          "$ref": "#/$defs/uint53",
          "description": "registry clock when the operator answered, ms"
        },
        "operator_ref": {
          "$ref": "#/$defs/opaqueRef",
          "description": "an opaque registry-side reference to the operator or aggregator. MUST NOT be, contain or be derived from an MSISDN."
        },
        "sig": {
          "$ref": "#/$defs/p1363",
          "description": "registry key ES256 over \"vcap/1.0/location\" ‖ core_hash ‖ JCS(attachment without sig)"
        }
      }
    }
  },
  "$defs": {
    "base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "bytes16": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$",
      "description": "16 bytes, base64url, no padding"
    },
    "bytes32": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "32 bytes, base64url, no padding"
    },
    "p1363": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "description": "ECDSA P-256 signature, r||s, 64 bytes, base64url"
    },
    "spkiP256": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{122}$",
      "description": "DER SubjectPublicKeyInfo of an EC P-256 key, 91 bytes, base64url"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.:_-]{0,63}$",
      "description": "A short machine name. Both spellings the format already uses are accepted: lowercase-hyphen (bch-255-131, base-sepolia) and camelCase (secureEnclave, playIntegrity, googleStatusList). The pattern is a gate against free text, not a style rule — a lowercase-only one rejected googleStatusList, a value the spec itself names, and the same trap was still armed on the extensible fields."
    },
    "opaqueRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "hexSerial": {
      "type": "string",
      "pattern": "^[0-9a-f]{2,40}$",
      "description": "certificate serial number, lowercase hex, no leading 0x"
    },
    "uint32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "description": "§6.1: an unsigned 32-bit integer, written as an integer literal"
    },
    "uint53": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "§6.1: a non-negative integer no larger than 2^53 − 1, the largest every JSON implementation reads exactly; timestamps in ms and counters that enter a uint64 message field"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": [
          "segments"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "media": {
            "type": "object",
            "required": [
              "segment_count"
            ]
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "media": {
            "type": "object",
            "properties": {
              "mime": {
                "type": "string",
                "pattern": "^video/"
              }
            },
            "required": [
              "mime"
            ]
          }
        },
        "required": [
          "media"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "segments"
        ],
        "properties": {
          "media": {
            "type": "object",
            "required": [
              "segment_count"
            ]
          }
        }
      }
    }
  ]
}
