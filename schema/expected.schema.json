{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "expected.json of a conformance vector",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "enum": [
        "file",
        "container",
        "segments",
        "jcs"
      ]
    },
    "outcome": {
      "enum": [
        "authentic",
        "verified_clip",
        "frames_not_compared",
        "tampered",
        "nested_proof",
        "corrupted_proof",
        "no_proof_found",
        "unsupported_format_version"
      ]
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "not_evaluated": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "core_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "segments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified"
      ],
      "properties": {
        "verified": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "schema_valid": {
      "type": "boolean",
      "description": "file and container vectors: whether proof.json conforms to vcap-proof-1.0.schema.json"
    },
    "core_bytes_hex": {
      "type": "string",
      "pattern": "^([0-9a-f]{2})+$"
    },
    "debug": {
      "type": "object"
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimed",
        "proven",
        "ceiling"
      ],
      "description": "\u00a77: the level claimed by the device, the level the evidence proves, and the ceiling the two allow.",
      "properties": {
        "claimed": {
          "type": "string"
        },
        "proven": {
          "type": "string"
        },
        "ceiling": {
          "enum": [
            "green",
            "amber",
            "red"
          ]
        }
      }
    },
    "validated_at": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instant",
        "source"
      ],
      "description": "\u00a77: the instant every certificate path was validated at, and what proved it.",
      "properties": {
        "instant": {
          "type": "string"
        },
        "source": {
          "enum": [
            "timestamp",
            "anchor",
            "device_clock",
            "verifier_clock"
          ]
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimed",
        "level"
      ],
      "description": "\u00a77.1: the position level the core claims and the level the evidence reaches. Orthogonal to the outcome.",
      "properties": {
        "claimed": {
          "enum": [
            "none",
            "declared",
            "corroborated",
            "authenticated"
          ]
        },
        "level": {
          "enum": [
            "none",
            "declared",
            "corroborated",
            "authenticated"
          ]
        }
      }
    },
    "proof_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "description": "\u00a73.2: where the proof was read. Diagnostic, never a label. For `c2pa` (an embedded store, or the external one the caller handed over), `manifest` is the label of the C2PA manifest that carried the proof and `depth` how far up the parentOf chain it sits (0: the active manifest).",
      "properties": {
        "kind": {
          "enum": [
            "trailer",
            "sidecar",
            "c2pa"
          ]
        },
        "manifest": {
          "type": "string"
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "c2pa"
              }
            }
          },
          "then": {
            "required": [
              "manifest",
              "depth"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "manifest"
                  ]
                },
                {
                  "required": [
                    "depth"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "frames_name_capture": {
      "type": "boolean",
      "description": "\u00a73.2: whether a GOP of the received file carries a vcap SEI naming the proof's capture_id. A locating hint, never evidence; present when the verifier read the container of a video proof."
    },
    "verifier_clock": {
      "type": "integer",
      "minimum": 0,
      "description": "An input, not an expectation: the verifier's own clock, ms. A \u00a77 verdict depends on it \u2014 a chain expires \u2014 so a vector that left it to the calendar would change its own answer over time."
    },
    "key_status": {
      "type": "object",
      "description": "An input, not an expectation: \u00a76.2's online key status as the verifier is assumed to have fetched it. Absent means the verifier could not ask, which is *revocation not checked* and caps the verdict at amber.",
      "additionalProperties": false,
      "required": [
        "log_id",
        "at",
        "tree_size",
        "status",
        "signature"
      ],
      "properties": {
        "log_id": {
          "type": "string"
        },
        "at": {
          "type": "integer",
          "minimum": 0
        },
        "tree_size": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "integer",
          "enum": [
            0,
            1,
            2
          ]
        },
        "signature": {
          "type": "string"
        }
      }
    },
    "chain_read": {
      "type": "object",
      "description": "An input, not an expectation: what a caller read from the anchoring contract for this `anchor_id`. Absent means the chain was not consulted, which is *anchoring not verified*. `block_time` is what makes the block's instant available to \u00a77.",
      "additionalProperties": false,
      "required": [
        "root",
        "tree_size"
      ],
      "properties": {
        "root": {
          "type": "string"
        },
        "tree_size": {
          "type": "integer",
          "minimum": 1
        },
        "block_time": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "writer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expect"
      ],
      "description": "For writer suites, never compared with a reader's verdict. `refuse`: sealing `input.<ext>` must fail with `error`. `not_covered`: nothing a vcap writer produces is exercised here, and a writer suite declares the vector NOT_COVERED.",
      "properties": {
        "expect": {
          "enum": [
            "refuse",
            "not_covered"
          ]
        },
        "error": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "expect": {
                "const": "refuse"
              }
            }
          },
          "then": {
            "required": [
              "error"
            ]
          }
        }
      ]
    },
    "c2pa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validator"
      ],
      "description": "Informative: what the named C2PA validator reports about the file's Content Credentials, active manifest only (`validation_state` and the status codes of C2PA 15.2.2, sorted), or the error it refuses the file with. No vcap verdict reads it.",
      "properties": {
        "validator": {
          "type": "string"
        },
        "validation_state": {
          "type": "string"
        },
        "success": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "informational": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failure": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "jcs"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "core_bytes_hex",
          "core_hash"
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "file",
              "container",
              "segments"
            ]
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "outcome",
          "labels",
          "not_evaluated"
        ]
      }
    }
  ]
}
